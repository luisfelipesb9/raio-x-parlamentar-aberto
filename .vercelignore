# Projeto Vercel da API (raiz do repo).
# LGPD: só a base PSEUDONIMIZADA vai para o deploy. Tudo em data/ é excluído,
# exceto data/sample/raio_x_publico.duckdb (gere com `make sample-publico` e rode a varredura).
web/
tests/
docs/
.venv/
.git/
node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/
# Segredos locais (ex.: RAIO_X_ID_SALT) nunca vão para o deploy.
.env
.env.*
.claude/
# Nenhum banco vai para o deploy, esteja onde estiver (a base pública é reaberta no fim).
*.duckdb
*.duckdb.wal
# Os diretórios precisam ser reabertos com `!data` e `!data/sample` (sem barra no fim); sem isso a
# CLI não envia a base. Confira com `vercel deploy --dry --json` antes de publicar.
data/*
!data
!data/sample
data/sample/*
!data/sample/raio_x_publico.duckdb
