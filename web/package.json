{
  "name": "raio-x-web",
  "version": "0.2.0",
  "description": "Interface web do Raio-X Parlamentar: fichas em linguagem simples, mapa de relações e explicação das conclusões.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cytoscape": "3.35.0",
    "cytoscape-fcose": "2.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cytoscape": "^3.31.0",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
