{
  "$defs": {
    "Diagnostico": {
      "description": "Por que um passo da prova ficou inconclusivo, em forma legível por máquina.\n\nConvenção de `detalhes` para a R01: `n_votos_validos`, `minimo_votos`, `taxa`, `limiar`.",
      "properties": {
        "motivo": {
          "enum": [
            "dados_insuficientes",
            "abaixo_do_limiar",
            "sem_regra_aplicavel"
          ],
          "title": "Motivo",
          "type": "string"
        },
        "detalhes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Detalhes",
          "type": "object"
        }
      },
      "required": [
        "motivo",
        "detalhes"
      ],
      "title": "Diagnostico",
      "type": "object"
    },
    "Nivel": {
      "enum": [
        "alta",
        "media",
        "indicio",
        "inconclusivo"
      ],
      "title": "Nivel",
      "type": "string"
    },
    "PassoProva": {
      "properties": {
        "profundidade": {
          "title": "Profundidade",
          "type": "integer"
        },
        "objetivo": {
          "title": "Objetivo",
          "type": "string"
        },
        "regra": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Regra"
        },
        "cf": {
          "title": "Cf",
          "type": "number"
        },
        "nota": {
          "title": "Nota",
          "type": "string"
        },
        "diagnostico": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostico"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "profundidade",
        "objetivo",
        "regra",
        "cf",
        "nota",
        "diagnostico"
      ],
      "title": "PassoProva",
      "type": "object"
    }
  },
  "description": "Resposta do encadeamento regressivo: 'o deputado X <objetivo>?' com a trilha da prova.",
  "properties": {
    "objetivo": {
      "title": "Objetivo",
      "type": "string"
    },
    "deputado_id": {
      "title": "Deputado Id",
